{{!
    @template block_workplanner/entry

    One entry of the week plan or the later area: a teacher's deadline or the user's own plan.
    Own plans can be dragged to another day or removed.

    Data attributes required for JS:
    * data-draggable and data-cmid on entries the user can move
    * data-action="plan" with data-slot="none" on the remove button

    Context variables required for this template:
    * canplan - Whether the user may plan activities (from the parent context)
    * cmid, courseid, name, url, hasurl, coursename, colorindex, isdeadline, deadlinetext, isdone, candrag

    Example context (json):
    {
        "canplan": true,
        "cmid": 12, "courseid": 5, "name": "Fractions practice", "url": "https://example.com/mod/assign/view.php?id=12",
        "hasurl": true, "coursename": "Maths 7b", "colorindex": 0, "isdeadline": false, "deadlinetext": "",
        "isdone": false, "candrag": true
    }
}}
<div class="block_workplanner-entry{{#isdeadline}} block_workplanner-deadline{{/isdeadline}}{{^isdeadline}} block_workplanner-c{{colorindex}}{{/isdeadline}}{{#isdone}} block_workplanner-done{{/isdone}}"
    data-cmid="{{cmid}}"{{#canplan}}{{#candrag}} draggable="true" data-draggable="true"{{/candrag}}{{/canplan}}>
    {{#isdeadline}}<span class="d-block fw-bold">{{deadlinetext}}</span>{{/isdeadline}}
    <span class="d-flex align-items-start gap-1">
        {{#isdone}}{{#pix}}i/checked, core, {{#str}}statedone, block_workplanner{{/str}}{{/pix}}{{/isdone}}
        <span class="flex-grow-1 block_workplanner-cardtext">
            {{#hasurl}}<a href="{{url}}" title="{{coursename}}" data-courseid="{{courseid}}">{{name}}</a>{{/hasurl}}
            {{^hasurl}}<span title="{{coursename}}">{{name}}</span>{{/hasurl}}
        </span>
        {{#canplan}}{{#candrag}}
        <button type="button" class="btn btn-link btn-sm p-0 block_workplanner-remove" data-action="plan" data-cmid="{{cmid}}"
            data-slot="none" data-day="0">
            {{#pix}}i/delete, core, {{#str}}removeplanfor, block_workplanner, {{name}}{{/str}}{{/pix}}
        </button>
        {{/candrag}}{{/canplan}}
    </span>
</div>
