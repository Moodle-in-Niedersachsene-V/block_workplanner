{{!
    @template block_workplanner/later

    The later area: activities the user wants to do without fixing a day. It takes
    dropped activities.

    Data attributes required for JS:
    * data-dropzone, data-slot="later" on the area

    Context variables required for this template:
    * haslater, later - Entries, see block_workplanner/entry

    Example context (json):
    {
        "canplan": true,
        "haslater": true,
        "later": [
            {"cmid": 12, "courseid": 5, "name": "Fractions practice", "url": "https://example.com/mod/assign/view.php?id=12",
                 "hasurl": true, "coursename": "Maths 7b", "colorindex": 0, "isdeadline": false, "deadlinetext": "",
                 "isdone": false, "candrag": true}
        ]
    }
}}
<div class="block_workplanner-later" {{#canplan}}data-dropzone="true" data-slot="later" data-day="0"{{/canplan}}>
    {{#haslater}}
    <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
        {{#later}}
        <li>{{> block_workplanner/entry}}</li>
        {{/later}}
    </ul>
    {{/haslater}}
    {{^haslater}}
    <p class="text-muted mb-0">{{#str}}nolater, block_workplanner{{/str}}</p>
    {{/haslater}}
</div>
