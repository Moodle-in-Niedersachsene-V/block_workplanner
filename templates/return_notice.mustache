{{!
    @template block_workplanner/return_notice

    Notice on the pages of a course the user opened from the work planner, with the way back.

    Data attributes required for JS:
    * data-action="returntoplanner" on the link back

    Context variables required for this template:
    * url - Address of the dashboard with the planner

    Example context (json):
    {
        "url": "https://example.com/my/"
    }
}}
<div class="alert alert-info d-flex flex-wrap align-items-center gap-2 block_workplanner-return" role="status">
    <span class="flex-grow-1">{{#str}}returnnotice, block_workplanner{{/str}}</span>
    <a class="btn btn-primary btn-sm" href="{{url}}" data-action="returntoplanner">
        {{#str}}returntoplanner, block_workplanner{{/str}}
    </a>
</div>
