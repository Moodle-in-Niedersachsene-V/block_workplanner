{{!
    @template block_workplanner/competencies

    Competencies of the user's activities with their state: in progress first, then open,
    then achieved. A summary line counts them; long titles are shortened to two lines.

    Context variables required for this template:
    * hascompetencies - Whether there are any
    * competencysummary - Number of competencies per state as text
    * competencies - List with title, coursenames, isachieved, isinprogress, isopen and statetext

    Example context (json):
    {
        "hascompetencies": true,
        "competencysummary": "1 achieved · 1 in progress · 1 open",
        "competencies": [
            {"title": "Calculate with fractions", "coursenames": "Maths 7b", "isachieved": false,
             "isinprogress": true, "isopen": false, "statetext": "In progress: 2 of 4 activities"},
            {"title": "Recite poems", "coursenames": "German 7b", "isachieved": false,
             "isinprogress": false, "isopen": true, "statetext": "Open: 0 of 1 activities"},
            {"title": "Read and understand texts", "coursenames": "German 7b", "isachieved": true,
             "isinprogress": false, "isopen": false, "statetext": "Achieved: 3 of 3 activities"}
        ]
    }
}}
{{#hascompetencies}}
<p class="small text-muted mb-2">{{competencysummary}}</p>
<ul class="list-unstyled mb-0 block_workplanner-scroll block_workplanner-competencylist">
    {{#competencies}}
    <li class="d-flex gap-2 mb-2 small">
        <span class="block_workplanner-state{{#isachieved}} block_workplanner-achieved{{/isachieved}}{{#isinprogress}} block_workplanner-inprogress{{/isinprogress}}" aria-hidden="true"></span>
        <div class="block_workplanner-cardtext">
            <div class="block_workplanner-clamp" title="{{title}}">{{title}}</div>
            <div class="text-muted">{{statetext}} · {{coursenames}}</div>
        </div>
    </li>
    {{/competencies}}
</ul>
{{/hascompetencies}}
{{^hascompetencies}}
<p class="text-muted mb-0">{{#str}}nocompetencies, block_workplanner{{/str}}</p>
{{/hascompetencies}}
